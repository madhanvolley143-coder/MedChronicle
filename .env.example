# MedChronicle Environment Configuration Template
# Copy this file to .env and configure with your local settings.
# NEVER commit your actual .env file or API keys to version control.

# Application Configuration
APP_NAME=MedChronicle
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Google Gemini LLM Provider (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_LLM_PROVIDER=gemini

# OCR Configuration (Tesseract)
# On Windows, commonly: C:/Program Files/Tesseract-OCR/tesseract.exe
# On Linux / Docker: /usr/bin/tesseract (or omit if in PATH)
TESSERACT_CMD=
OCR_LANGUAGES=eng

# Optional Offline / Development LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=450.0

# SAFETY & COMPLIANCE POLICY:
# - Synthetic patient data only.
# - Never use or store real patient records.
# - Store API keys in .env and never commit secrets to version control.
